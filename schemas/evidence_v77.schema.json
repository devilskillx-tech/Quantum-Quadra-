{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/quadra/evidence-v77.schema.json",
  "title": "QUADRA v7.7 untrusted CI evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository", "commit_sha", "pr_number", "generated_at", "controls"],
  "properties": {
    "schema_version": {"const": "quadra.evidence.v77.1"},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "pr_number": {"type": "integer", "minimum": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "controls": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["control_id", "run_id", "job_id", "artifact_id", "evidence_sha256", "result"],
        "properties": {
          "control_id": {"type": "string", "pattern": "^[a-z0-9-]{1,48}$"},
          "run_id": {"type": "integer", "minimum": 1},
          "job_id": {"type": "integer", "minimum": 1},
          "artifact_id": {"type": "integer", "minimum": 1},
          "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "result": {"const": "PASS"}
        }
      }
    }
  }
}
